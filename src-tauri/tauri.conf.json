{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "时间记录",
  "version": "0.1.0",
  "identifier": "com.hermes.timerecord",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "timer",
        "title": "时间记录",
        "width": 330,
        "height": 500,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "visible": false
      },
      {
        "label": "history",
        "title": "历史记录",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 420,
        "height": 390,
        "minWidth": 360,
        "minHeight": 260,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
